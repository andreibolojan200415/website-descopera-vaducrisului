---
import '../styles/global.css';

const faviconSvgUrl = `${import.meta.env.BASE_URL}favicon.svg`;
const faviconIcoUrl = `${import.meta.env.BASE_URL}favicon.ico`;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
		<link rel="icon" href={faviconIcoUrl} />
		<meta name="generator" content={Astro.generator} />
		<title>Descoperă Vadu Crișului</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
